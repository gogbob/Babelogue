# Copy to backend/.env (git-ignored). Only the backend reads it.

# GPU audio processing service (API_PCGPU.md). Mock: uvicorn mock_audio_service.main:app --port 8001
AUDIO_SERVICE_URL=http://localhost:8001

# Speech-to-text: faster_whisper | dummy
STT_BACKEND=faster_whisper
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
PARTIAL_TRANSCRIPTS=true

# Translation: azure | echo   (echo = no-op for development without Azure)
TRANSLATOR_BACKEND=azure

# Azure AI Speech (TTS)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=canadaeast

# Azure AI Translator (translation). Region is required for regional / multi-service keys
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=canadaeast

# Chunking sent to the audio service (seconds)
CHUNK_SECONDS=5.0
HOP_SECONDS=2.5
